<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Raccoonwatch</RootNamespace>
    <AssemblyName>raccoonwatch</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\raccoonwatch.ico</ApplicationIcon>
    <IncludeContentInSingleFile>true</IncludeContentInSingleFile>
    <Version>1.0.0</Version>
    <Product>raccoonwatch</Product>
    <Description>Windows tray application to start, restart, stop and monitor processes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\raccoonwatch.ico" Link="raccoonwatch.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="..\..\assets\raccoonwatch.ico"
                      LogicalName="Raccoonwatch.assets.raccoonwatch.ico" />
    <EmbeddedResource Include="..\..\assets\raccoonwatch_icon_1254x1254.png"
                      LogicalName="Raccoonwatch.assets.raccoonwatch_icon_1254x1254.png" />
    <EmbeddedResource Include="..\..\assets\github-mark.png"
                      LogicalName="Raccoonwatch.assets.github-mark.png" />
  </ItemGroup>

</Project>
